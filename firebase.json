{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "predeploy": [
      "pnpm --dir \"$RESOURCE_DIR\" run lint",
      "pnpm --dir \"$RESOURCE_DIR\" run build"
    ],
    "source": "apps/backend"
  },
  "hosting": {
    "public": "apps/frontend/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/v1/**",
        "function": {
          "functionId": "webApi",
          "region": "africa-south1"
        }
      }
    ]
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 19099 },
    "firestore": { "host": "127.0.0.1", "port": 28080 },
    "functions": { "host": "127.0.0.1", "port": 15001 },
    "hosting": { "host": "127.0.0.1", "port": 15000 },
    "ui": { "enabled": true, "host": "127.0.0.1", "port": 14000 },
    "singleProjectMode": true
  }
}
